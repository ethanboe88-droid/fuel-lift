{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fuel-lift",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fuel-lift",
      "database_id": "a825bdab-f40a-49c0-a5f6-b1e9a53ed2ff",
      "migrations_dir": "migrations"
    }
  ],
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Public (non-secret) settings. Clerk's publishable key and JWT public key are designed to be public.
  "vars": {
    "CLERK_PUBLISHABLE_KEY": "pk_test_Z3JhbmQta2lkLTgwNTYuY2xlcmsuYWNjb3VudHMuZGV2JA==",
    "CLERK_JWT_KEY": "-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA67gXD03xQk19WssWPgi8\nNS7idzzIUNNpajFpqnU7J2nzBKIxKuSchsFwbIjwn478xTDH2IBMMEvqwHRrVHGx\n0PVnhWVmlYYfrMMxbDkhZxJNmu+voXQ80RC1oO+m6Nhw04SqPO5euPG+ne0A9AU9\np0YCbxcnAewezGhkOyIqiippSXTkd0Y3MKyyPPYj0X/HuJwbt3Pvcp9qOmMGMSws\nUtidFsD9AHWPkIEpld6G4dOzdBh4zt5q6X921qsUOuJVestmKzw1pQwjXfoJQTRf\n2i8IPFBSHhiysdxOsVWrGdUY/upZ+hXdl2lS4Dvp6eSsZQ/cthdyDHyKW2zW0in1\niQIDAQAB\n-----END PUBLIC KEY-----",
    // Ethan's Clerk user ID (user_...). His pre-accounts data is attached to this account on first login,
    // and he is exempt from the AI cap. Fill in after he signs up.
    "OWNER_USER_ID": "",
    "AI_DAILY_LIMIT": "30"
  }
  // Secrets (set in Cloudflare dashboard → Settings → Variables and Secrets):
  //   ANTHROPIC_API_KEY  – from console.anthropic.com
  //   (APP_PASSWORD is no longer used once accounts are live; delete it after rollout)
}
